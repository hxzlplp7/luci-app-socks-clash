
config socks-clash 'config'
	option enable '0'
	option socks_port '7891'
	option http_port '7890'
	option mixed_port '7893'
	option redir_port '7892'
	option tproxy_port '7895'
	option dns_port '7874'
	option cn_port '9090'
	option dashboard_password ''
	option log_level 'info'
	option mode 'rule'
	option allow_lan '1'
	option bind_address '*'
	option ipv6 '0'
	option external_controller '0.0.0.0:9090'
	option external_ui 'dashboard'
	option config_path '/etc/socks-clash/config/config.yaml'
	option core_path '/etc/socks-clash/core/clash'
	option proxy_mode 'proxy_only'
	option socks_enabled '1'
	option http_enabled '1'
	option mixed_enabled '0'

config proxy_group 'default'
	option name 'PROXY'
	option type 'select'
	list proxies 'DIRECT'
	list proxies 'REJECT'

config rules 'default'
	option enabled '1'
	list rule 'DOMAIN-SUFFIX,google.com,PROXY'
	list rule 'DOMAIN-SUFFIX,youtube.com,PROXY'
	list rule 'DOMAIN-SUFFIX,github.com,PROXY'
	list rule 'GEOIP,CN,DIRECT'
	list rule 'MATCH,PROXY'

